#include <LPC17xx.h>

unsigned char tohex[10] = {0X3F, 0X06, 0X5B, 0X4F, 0X66, 0X6D, 0X7D, 0X07, 0X7F, 0X6F};
int arr[4] = {0, 0, 0, 0}; 




void initTimer()
{
 
    LPC_TIM0->CTCR = 0x0;   
    LPC_TIM0->TCR  = 0x02; 
    LPC_TIM0->PR   = 2;     
    LPC_TIM0->MR0  = 999999; 
    LPC_TIM0->MCR  = 2;     
    LPC_TIM0->EMR  = 0x20;  
    LPC_TIM0->TCR  = 0x01;  
}


void delay()
{
    initTimer();
    while (!(LPC_TIM0->EMR & 1)); 
}


void updateDisplay()
{
    for (int i = 0; i < 4; i++)  
    {
        LPC_GPIO1->FIOPIN = i << 23;      
        LPC_GPIO0->FIOPIN = tohex[arr[i]] << 4; 
        delay(); 
    }
}


int main()
{
   
    LPC_PINCON->PINSEL0 = LPC_PINCON->PINSEL0 & 0xFF0000FF; 
    LPC_GPIO0->FIODIR |= 0XFF0;   

  
    LPC_PINCON->PINSEL3 = LPC_PINCON->PINSEL3 & 0xF00FFFFF; 
    LPC_GPIO1->FIODIR |= 0xF << 23; 


    LPC_PINCON->PINSEL4 = LPC_PINCON->PINSEL4 & 0xFFCFFFFF; 
    LPC_GPIO2->FIODIR = LPC_GPIO2->FIODIR &=0xFFFFEFFF;

    while (1)
    {

        int switchState = LPC_GPIO2->FIOPIN & (1<<12);

      
        if (switchState) 
        {
            arr[0] = arr[0] + 1;
            if (arr[0] > 9)
            {
                arr[0] = 0;
                arr[1] = arr[1] + 1;
                if (arr[1] > 9)
                {
                    arr[1] = 0;
                    arr[2] = arr[2] + 1;
                    if (arr[2] > 9)
                    {
                        arr[2] = 0;
                        arr[3] = arr[3] + 1;
                        if (arr[3] > 9)
                        {
                            arr[3] = 0;
                        }
                    }
                }
            }
        }
        else 
        {
            if (arr[0] == 0)
            {
                arr[0] = 9;
                if (arr[1] == 0)
                {
                    arr[1] = 9;
                    if (arr[2] == 0)
                    {
                        arr[2] = 9;
                        if (arr[3] == 0)
                        {
                            arr[3] = 9;
                        }
                        else
                        {
                            arr[3] = arr[3] - 1;
                        }
                    }
                    else
                    {
                        arr[2] = arr[2] - 1;
                    }
                }
                else
                {
                    arr[1] = arr[1] - 1;
                }
            }
            else
            {
                arr[0] = arr[0] - 1;
            }
        }

       
        updateDisplay();
    }
}
