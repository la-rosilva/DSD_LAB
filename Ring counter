Ring counter #include <LPC17xx.h>

void delay(void) {
    unsigned int i;
    for (i = 0; i < 1000000; i++);  // Simple delay
}

int main(void) {
    unsigned char ring = 0x01;  // Initial ring value (00000001)

    SystemInit();               
    SystemCoreClockUpdate();     

    // Configure P0.4 - P0.11 as GPIO output for LEDs
    LPC_PINCON->PINSEL0 &= 0xFF0000FF;  
    LPC_GPIO0->FIODIR |= 0x00000FF0;    

    // Configure P2.10 (SW2) as GPIO input
    LPC_PINCON->PINSEL4 &= ~(3 << 20);  
    LPC_GPIO2->FIODIR &= ~(1 << 10);    

    while (1) {
        // Wait for key press (SW2 = 1)
        while (!(LPC_GPIO2->FIOPIN & (1 << 10)));  // Wait for SW2 press

        // Display ring counter value on LEDs (shift to P0.4 - P0.11)
        LPC_GPIO0->FIOPIN = (ring << 4);

        delay();  // Add delay for debounce effect

        // Shift left, reset if out of range
        ring <<= 1;
        if (ring > 0x80) {  // If beyond 8th position, reset to 00000001
            ring = 0x01;
        }

        // Wait for key release (SW2 = 0)
        while (LPC_GPIO2->FIOPIN & (1 << 10));  // Wait for SW2 release
    }
}
